OLLAMA_HOST=http://localhost:11434
# Non-thinking Qwen3 variant. The plain `qwen3:4b` tag is a thinking model: it ignores
# think=false and leaks its reasoning into the answer, and is several times slower.
CHAT_MODEL=qwen3:4b-instruct
EMBED_MODEL=bge-m3
TOP_K=4
# Relevance gate: the best chunk must reach this cosine similarity, otherwise the documents
# are treated as not covering the question. Measured on data/hr-policies.md with bge-m3:
# correct chunks scored 0.617-0.748 (20 queries), out-of-scope best chunks 0.310-0.564
# (6 queries). 0.59 is the midpoint of that gap; re-measure after changing docs or models.
MIN_SIMILARITY=0.59
MAX_AGENT_ITERATIONS=5
